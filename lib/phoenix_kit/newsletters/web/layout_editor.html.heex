<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  socket={assigns[:socket]}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  current_locale={assigns[:current_locale]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@url_path}
  project_title={@project_title}
>
<div class="container flex-col mx-auto px-4 py-6">
  <form id="layout-form" phx-change="validate" phx-submit="save">
    <input type="hidden" name="editor_language" value={@editor_locale} />
    <%!-- Every other tab's text as it stands. Only the open tab's fields are
         inputs, and form recovery after a reconnect replays only the form, so
         without these an unsaved edit on any other tab went back to the stored
         text, and Save wrote that. --%>
    <input
      :for={{field, key, value} <- other_tab_values(@translations, @editor_keys)}
      type="hidden"
      name={"all[#{field}][#{key}]"}
      value={value}
    />
    <div :if={@errors != []} class="alert alert-error mb-4">
      <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
      <ul class="text-sm">
        <li :for={error <- @errors}>{error}</li>
      </ul>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <.input
            id="layout-name"
            name="name"
            value={@name}
            label={gettext("Name")}
            class="font-mono"
            placeholder="monthly_layout"
            phx-debounce="300"
            hint={
              gettext(
                "Lowercase Latin letters, numbers and underscores; starts with a letter. For example: monthly_news."
              )
            }
          />
          <p :if={@suggested_name} class="label text-xs whitespace-normal">
            {gettext("Suggested name:")}
            <code class="font-mono">{@suggested_name}</code>
            <button
              type="button"
              class="btn btn-xs btn-ghost"
              phx-click="use_suggested_name"
            >
              {gettext("Use this name")}
            </button>
          </p>
        </div>

        <div role="tablist" class="tabs tabs-border flex-wrap">
          <button
            :for={tab <- @tabs}
            type="button"
            role="tab"
            class={["tab", tab.language == @editor_locale && "tab-active"]}
            phx-click="switch_language"
            phx-value-language={tab.language}
          >
            {tab.language}
            <span
              :if={filled?(@translations["html_body"], tab.keys["html_body"])}
              class="badge badge-xs badge-success ml-1"
            >
            </span>
            <span :if={tab.residue?} class="badge badge-xs badge-warning ml-1">
              {gettext("subject not used by sends")}
            </span>
            <span :if={not tab.site? and not tab.residue?} class="badge badge-xs badge-warning ml-1">
              {gettext("not a site language")}
            </span>
          </button>
        </div>

        <%!-- Keyed by language so switching tabs replaces the inputs
             instead of morphing one language's text into another's. --%>
        <div
          id={"layout-fields-#{@editor_tab.locale}#{if @editor_tab.residue?, do: "-subject"}"}
          class="space-y-4"
        >
          <p :if={@editor_tab.residue?} class="alert alert-warning text-sm whitespace-normal">
            {gettext(
              "This subject is stored under %{key}, but a send reads the subject in the language of the HTML, so it is never used. Copy it to the right language tab, or clear it to remove it.",
              key: @editor_tab.locale
            )}
          </p>
          <div>
            <.input
              id="layout-display-name"
              name="fields[display_name]"
              value={Map.get(@translations["display_name"], @editor_keys["display_name"], "")}
              label={gettext("Display name")}
              disabled={is_nil(@editor_keys["display_name"])}
              phx-debounce="300"
            />
            <p :if={is_nil(@editor_keys["display_name"])} class="label text-xs whitespace-normal">
              {gettext("Not editable here: in this field the language is stored under another tab.")}
            </p>
          </div>

          <div>
            <.input
              id="layout-subject"
              name="fields[subject]"
              value={Map.get(@translations["subject"], @editor_keys["subject"], "")}
              label={gettext("Subject pattern (optional)")}
              disabled={is_nil(@editor_keys["subject"])}
              placeholder="{{subject}}"
              phx-debounce="300"
              hint={
                gettext(
                  "Must contain {{subject}}, the broadcast's own subject. Leave blank to send the broadcast's subject unchanged."
                )
              }
            />
            <p :if={is_nil(@editor_keys["subject"])} class="label text-xs whitespace-normal">
              {gettext("Not editable here: in this field the language is stored under another tab.")}
            </p>
          </div>

          <div>
            <.textarea
              id="layout-html"
              name="fields[html_body]"
              value={Map.get(@translations["html_body"], @editor_keys["html_body"], "")}
              label={gettext("HTML")}
              disabled={is_nil(@editor_keys["html_body"])}
              class="font-mono text-xs"
              rows="18"
              phx-debounce="500"
              hint={
                gettext(
                  "{{{content}}} is the broadcast. Also available: {{{header}}}, {{{footer}}}, {{logo_url}}, {{accent_color}}, {{site_name}}, {{site_url}}, {{subject}}, {{name}}, {{email}}, {{unsubscribe_url}}, {{preferences_url}}."
                )
              }
            />
            <p :if={is_nil(@editor_keys["html_body"])} class="label text-xs whitespace-normal">
              {gettext("Not editable here: in this field the language is stored under another tab.")}
            </p>
          </div>

          <div>
            <.textarea
              id="layout-text"
              name="fields[text_body]"
              value={Map.get(@translations["text_body"], @editor_keys["text_body"], "")}
              label={gettext("Text (kept for reference)")}
              disabled={is_nil(@editor_keys["text_body"])}
              class="font-mono text-xs"
              rows="5"
              phx-debounce="500"
            />
            <p :if={is_nil(@editor_keys["text_body"])} class="label text-xs whitespace-normal">
              {gettext("Not editable here: in this field the language is stored under another tab.")}
            </p>
          </div>
        </div>

        <.form_actions cancel_to={Paths.layouts_index()} submit_label={gettext("Save layout")} />
      </div>

      <div>
        <span class="label">{gettext("Preview")} · {@editor_locale}</span>
        <div
          class="border border-base-300 rounded-lg overflow-hidden bg-white"
          style="height: 640px;"
        >
          <%= if @preview_html != "" do %>
            <iframe srcdoc={@preview_html} class="w-full h-full border-0" sandbox="allow-same-origin">
            </iframe>
          <% else %>
            <div class="flex items-center justify-center h-full text-base-content/40">
              <p class="text-sm">{gettext("No HTML in this language yet")}</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </form>
</div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
