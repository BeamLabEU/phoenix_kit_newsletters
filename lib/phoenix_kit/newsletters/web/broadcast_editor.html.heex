<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  socket={assigns[:socket]}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  current_locale={assigns[:current_locale]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  page_crumbs={@page_crumbs}
  current_path={@url_path}
  project_title={@project_title}
>
<div class="container flex-col mx-auto px-4 py-6">
  <form id="broadcast-form" phx-change="validate" phx-submit="submit">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <%!-- Left: Editor --%>
      <div class="space-y-4">
        <.input
          id="broadcast-subject"
          name="subject"
          value={@subject}
          label={gettext("Subject")}
          placeholder={gettext("Enter email subject...")}
          phx-debounce="300"
        />

        <%!-- Recipient source — "Roles" targets core users by role and is
             always available; "CRM list" only appears when the CRM module
             is installed. Real radios drawn as buttons (daisyUI writes the
             aria-label on them), as on the verification page, so the
             keyboard reaches them: hidden radios inside labels it did not. --%>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{gettext("Send to")}</legend>
          <div class="join">
            <input
              type="radio"
              name="source_type"
              value="user_group"
              checked={@source_type == "user_group"}
              class="join-item btn btn-sm"
              aria-label={gettext("Roles")}
            />
            <input
              :if={@crm_available}
              type="radio"
              name="source_type"
              value="crm_list"
              checked={@source_type == "crm_list"}
              class="join-item btn btn-sm"
              aria-label={gettext("CRM list")}
            />
          </div>
        </fieldset>

        <div :if={@source_type == "crm_list" && @crm_available}>
          <%!-- A current selection that fell out of the picker's options
               (archived, or no longer subscribable) stays visible as a
               disabled option (crm_list_options/2): without it the browser
               falls back to the placeholder and the next save silently resets
               crm_list_uuid — the operator never learns the broadcast lost its
               audience. --%>
          <.select
            id="broadcast-crm-list"
            name="crm_list_uuid"
            value={@crm_list_uuid}
            label={gettext("CRM list")}
            prompt={gettext("Select a list...")}
            options={crm_list_options(@crm_lists, @stranded_crm_list)}
          />
          <p :if={@crm_list_archived?} class="text-xs text-warning mt-1">
            <.icon name="hero-exclamation-triangle" class="w-3 h-3 inline" />
            {gettext("This list is archived and cannot be sent to.")}
          </p>
          <p :if={@preflight} class="text-xs text-base-content/60 mt-1">
            {ngettext(
              "%{count} member: %{sendable} sendable, %{no_email} no email, %{unsendable} unsubscribed/opted-out",
              "%{count} members: %{sendable} sendable, %{no_email} no email, %{unsendable} unsubscribed/opted-out",
              @preflight.total,
              sendable: @preflight.sendable,
              no_email: @preflight.no_email,
              unsendable: @preflight.unsendable
            )}
          </p>
        </div>

        <fieldset :if={@source_type == "user_group"} class="fieldset">
          <legend class="fieldset-legend">{gettext("Roles")}</legend>
          <div class="flex flex-col gap-1">
            <%!-- No hidden fallback: an unticked role submits nothing. --%>
            <.checkbox
              :for={role <- @available_roles}
              name="role_uuids[]"
              value={role.uuid}
              unchecked_value={nil}
              checked={role.uuid in @role_uuids}
              label={role.name}
              class="checkbox-sm"
              wrapper_class="gap-2"
            />
          </div>
          <p :if={@preflight} class="text-xs text-base-content/60 mt-1">
            {ngettext(
              "%{count} user: %{sendable} sendable, %{no_email} no email, %{unsendable} unsubscribed/opted-out",
              "%{count} users: %{sendable} sendable, %{no_email} no email, %{unsendable} unsubscribed/opted-out",
              @preflight.total,
              sendable: @preflight.sendable,
              no_email: @preflight.no_email,
              unsendable: @preflight.unsendable
            )}
          </p>
          <p :if={@preflight && @preflight.stale_roles > 0} class="text-xs text-warning mt-1">
            <.icon name="hero-exclamation-triangle" class="w-3 h-3 inline" />
            {ngettext(
              "%{count} selected role no longer exists",
              "%{count} selected roles no longer exist",
              @preflight.stale_roles,
              count: @preflight.stale_roles
            )}
          </p>
        </fieldset>

        <div>
          <.select
            id="broadcast-layout"
            name="template_uuid"
            value={@template_uuid}
            label={gettext("Layout")}
            prompt={gettext("Standard email layout")}
            options={Enum.map(@templates, &{template_display_name(&1, @current_locale), &1.uuid})}
          />
          <p class="label text-xs mt-1">
            <%!-- A new tab: this form holds work nothing has saved yet. --%>
            <.link href={Paths.layouts_index()} target="_blank" class="link">
              {gettext("Manage layouts")}
            </.link>
          </p>
        </div>

        <%!-- Attachments. The picker sets them, but they are in the form too, so
             form recovery after a reconnect brings them back; the marker says the
             list is there even when it is empty. --%>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{gettext("Attachments")}</legend>
          <input type="hidden" name="attachments_sent" value="true" />
          <input :for={uuid <- @attachments} type="hidden" name="attachments[]" value={uuid} />
          <div class="flex flex-wrap gap-2">
            <div
              :for={{uuid, file} <- @attachment_files}
              class={[
                "badge gap-1 py-3 pl-3 pr-1",
                if(file, do: "badge-outline", else: "badge-outline badge-error opacity-70")
              ]}
            >
              <.icon
                name={if file, do: "hero-paper-clip", else: "hero-exclamation-triangle"}
                class="w-3 h-3"
              />
              <%= if file do %>
                <span class="max-w-40 truncate" title={file.original_file_name}>
                  {file.original_file_name}
                </span>
                <span class="text-base-content/50">({format_file_size(file.size)})</span>
              <% else %>
                <span class="italic" title={uuid}>{gettext("missing file")}</span>
              <% end %>
              <button
                type="button"
                phx-click="remove_attachment"
                phx-value-uuid={uuid}
                class="btn btn-circle btn-ghost btn-xs"
                aria-label={gettext("Remove attachment")}
              >
                <.icon name="hero-x-mark" class="w-3 h-3" />
              </button>
            </div>
            <button
              type="button"
              phx-click="open_attachments_picker"
              class="btn btn-outline btn-sm"
            >
              <.icon name="hero-plus" class="w-4 h-4" /> {gettext("Add files")}
            </button>
          </div>
          <p :if={attachments_size_warning?(@attachment_files)} class="text-xs text-warning mt-1">
            <.icon name="hero-exclamation-triangle" class="w-3 h-3 inline" />
            {gettext(
              "Attachments total %{size} — large attachments can slow delivery.",
              size: format_file_size(attachments_total_bytes(@attachment_files))
            )}
          </p>
        </fieldset>

        <%!-- Markdown Editor --%>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{gettext("Content (Markdown)")}</legend>
          <.live_component
            module={PhoenixKitWeb.Components.Core.MarkdownEditor}
            id="broadcast-editor"
            content={@markdown_content}
            save_status={:saved}
            show_formatting_toolbar={true}
            protect_navigation={false}
            height="400px"
            placeholder={gettext("Write your broadcast content in Markdown...")}
          />
        </fieldset>

        <%!-- Actions --%>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <.link navigate={Paths.broadcasts_index()} class="btn btn-ghost btn-sm">
            {gettext("Cancel")}
          </.link>
          <%!-- LiveView disables every button of the form while a submit is in
               flight; @sending covers the send that runs after its answer. --%>
          <button
            type="submit"
            name="action"
            value="save_draft"
            class="btn btn-outline btn-sm"
            disabled={@sending}
          >
            {gettext("Save draft")}
          </button>

          <%!-- Submit (not phx-click) buttons, branched by name="action":
               a phx-click event carries no form data, which used to wipe
               the role checkboxes on send/schedule — see the "submit"
               handler's comment. --%>
          <button
            :if={@can_send}
            type="submit"
            name="action"
            value="send_now"
            class="btn btn-primary btn-sm"
            disabled={
              @sending or @subject == "" or blank?(@markdown_content) or
                recipient_source_missing?(assigns) or nobody_to_send_to?(assigns)
            }
          >
            <%= if @sending do %>
              <span class="loading loading-spinner loading-xs"></span> {gettext("Sending")}
            <% else %>
              <.icon name="hero-paper-airplane" class="w-4 h-4" /> {gettext("Send now")}
            <% end %>
          </button>

          <div :if={@can_send} class="flex flex-col items-end gap-1 ml-auto">
            <div class="flex items-center gap-2">
              <input
                type="datetime-local"
                name="scheduled_at"
                value={@scheduled_at}
                class="input input-sm"
              />
              <button
                type="submit"
                name="action"
                value="schedule"
                class="btn btn-secondary btn-sm"
                disabled={
                  @sending or @scheduled_at == "" or @subject == "" or
                    blank?(@markdown_content) or recipient_source_missing?(assigns)
                }
              >
                <.icon name="hero-clock" class="w-4 h-4" /> {gettext("Schedule")}
              </button>
            </div>
            <p
              :if={schedule_preview(@scheduled_at, @tz, @tz_label)}
              class="text-xs text-base-content/60"
            >
              {schedule_preview(@scheduled_at, @tz, @tz_label)}
            </p>
          </div>
        </div>
      </div>

      <%!-- Right: Preview --%>
      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="label">{gettext("Preview")}</span>
          <%!-- daisyUI's inline label, which core's select does not draw. --%>
          <label :if={length(@preview_languages) > 1} class="select select-sm">
            <span class="label">{gettext("Language")}</span>
            <select name="preview_locale">
              <option
                :for={language <- @preview_languages}
                value={language}
                selected={@preview_locale == language}
              >
                {language}
              </option>
            </select>
          </label>
        </div>
        <div
          class="border border-base-300 rounded-lg overflow-hidden bg-white"
          style="height: 580px;"
        >
          <%= if @preview_html != "" do %>
            <iframe
              srcdoc={@preview_html}
              class="w-full h-full border-0"
              sandbox="allow-same-origin"
            >
            </iframe>
          <% else %>
            <div class="flex items-center justify-center h-full text-base-content/40">
              <div class="text-center">
                <.icon name="hero-eye" class="w-10 h-10 mx-auto mb-2 opacity-40" />
                <p class="text-sm">{gettext("Preview will appear here as you type")}</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </form>

  <%!-- Kept OUTSIDE the form: the modal's internal search filter renders a
       bare type="submit" button (media_selector_modal.html.heex) for its
       own inner form — nesting it inside our phx-submit="submit" form
       would let that button bubble up and submit the whole broadcast. --%>
  <.live_component
    module={MediaSelectorModal}
    id="broadcast-attachments-picker"
    show={@show_media_selector}
    mode={:multiple}
    max_select={Broadcast.max_attachments()}
    selected_uuids={@attachments}
    phoenix_kit_current_user={@phoenix_kit_current_user}
  />
</div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
