<div class="min-h-screen flex items-center justify-center bg-base-200 p-4">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title text-lg">{gettext("Manage email subscriptions")}</h2>

      <%= case @crm_state do %>
        <% :invalid -> %>
        <div class="alert alert-warning text-sm">
          <span>{gettext("This unsubscribe link is no longer valid.")}</span>
        </div>
        <% :failed -> %>
        <div class="alert alert-warning text-sm">
          <span>{gettext("We could not unsubscribe you right now. Please try again.")}</span>
        </div>
        <% :unsubscribed_all -> %>
        <div class="alert alert-success text-sm">
          <span>{gettext("You've been unsubscribed from all newsletters.")}</span>
        </div>
        <% _list_state -> %>
        <p class="text-sm text-base-content/70">
          <%= case @crm_state do %>
            <% :confirm -> %>
              {gettext("Unsubscribe from %{list}?", list: @crm_list.name)}
            <% :already_unsubscribed -> %>
              {gettext("You were already unsubscribed from %{list}.", list: @crm_list.name)}
            <% :unsubscribed -> %>
              {gettext("You've been unsubscribed from %{list}.", list: @crm_list.name)}
          <% end %>
        </p>

        <%= if @crm_state == :confirm do %>
          <form method="post" action={PhoenixKit.Newsletters.Paths.unsubscribe()}>
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="token" value={@token} />
            <input type="hidden" name="scope" value="list" />
            <button type="submit" class="btn btn-warning btn-outline btn-block">
              {gettext("Unsubscribe from this list")}
            </button>
          </form>
        <% end %>

        <div class="divider text-xs text-base-content/50">{gettext("OR")}</div>

        <form method="post" action={PhoenixKit.Newsletters.Paths.unsubscribe()}>
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="token" value={@token} />
          <input type="hidden" name="scope" value="all" />
          <button type="submit" class="btn btn-warning btn-outline btn-block">
            {gettext("Unsubscribe from all newsletters")}
          </button>
        </form>
      <% end %>
    </div>
  </div>
</div>
