<div class="min-h-screen flex items-center justify-center bg-base-200 p-4">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title text-lg">{gettext("Manage email subscriptions")}</h2>

      <%= case @role_optout_state do %>
        <% :invalid -> %>
        <div class="alert alert-warning text-sm">
          <span>{gettext("This unsubscribe link is no longer valid.")}</span>
        </div>
        <% :failed -> %>
        <div class="alert alert-warning text-sm">
          <span>{gettext("We could not unsubscribe you right now. Please try again.")}</span>
        </div>
        <% _state -> %>
        <p class="text-sm text-base-content/70">
          <%= case @role_optout_state do %>
            <% :confirm -> %>
              {gettext("Unsubscribe from these newsletters?")}
            <% :already_unsubscribed -> %>
              {gettext("You've already unsubscribed from these newsletters.")}
            <% :unsubscribed -> %>
              {gettext("You've been unsubscribed from these newsletters.")}
          <% end %>
        </p>

        <%= if @role_optout_state == :confirm do %>
          <form method="post" action={PhoenixKit.Newsletters.Paths.unsubscribe()}>
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="token" value={@token} />
            <input type="hidden" name="scope" value="role_optout" />
            <button type="submit" class="btn btn-warning btn-outline btn-block">
              {gettext("Unsubscribe")}
            </button>
          </form>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
