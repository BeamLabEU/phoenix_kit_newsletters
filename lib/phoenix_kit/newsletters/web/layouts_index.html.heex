<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  socket={assigns[:socket]}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  current_locale={assigns[:current_locale]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@url_path}
  project_title={@project_title}
>
<div class="container flex-col mx-auto px-4 py-6">
  <p class="text-sm text-base-content/70 mb-4">
    {gettext(
      "A broadcast without a layout is sent inside the site's standard email layout. A layout places the broadcast with {{{content}}} and can place the site's {{{header}}} and {{{footer}}}."
    )}
  </p>

  <%!-- The plain table keeps its toolbar with no rows, so the filter and New
       layout stay on screen for an empty list. --%>
  <.table_default id="layouts-table" variant="zebra" size="sm" class="w-full">
    <:toolbar_title>
      <form id="layouts-status-filter" phx-change="filter_status">
        <.select
          name="status"
          value={@status_filter}
          options={[
            {gettext("Active"), "active"},
            {gettext("Archived"), "archived"},
            {gettext("All statuses"), "all"}
          ]}
          class="select-sm"
          aria-label={gettext("Status")}
        />
      </form>
    </:toolbar_title>
    <:toolbar_actions>
      <button :if={@default_uuid} type="button" class="btn btn-ghost btn-sm" phx-click="clear_default">
        {gettext("Use the standard layout by default")}
      </button>
    </:toolbar_actions>
    <:toolbar_primary>
      <.link navigate={Paths.layout_new()} class="btn btn-primary btn-sm">
        <.icon name="hero-plus" class="w-4 h-4" /> {gettext("New layout")}
      </.link>
    </:toolbar_primary>

    <.table_default_header>
      <.table_default_row>
        <.table_default_header_cell>{gettext("Name")}</.table_default_header_cell>
        <.table_default_header_cell>{gettext("Languages")}</.table_default_header_cell>
        <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
        <.table_default_header_cell class="text-right">
          <span class="sr-only">{gettext("Actions")}</span>
        </.table_default_header_cell>
      </.table_default_row>
    </.table_default_header>

    <.table_default_body>
      <.table_default_row :if={@layouts == []} hover={false}>
        <.table_default_cell colspan={4}>
          <.empty_state
            icon="hero-rectangle-group"
            title={gettext("No layouts found")}
            description={gettext("Broadcasts use the standard email layout until you add one.")}
          />
        </.table_default_cell>
      </.table_default_row>

      <.table_default_row :for={layout <- @layouts} id={"layout-#{layout.uuid}"}>
        <.table_default_cell>
          <div class="font-medium">{Layout.display_name(layout, @current_locale)}</div>
          <div class="text-xs text-base-content/60 font-mono">{layout.name}</div>
        </.table_default_cell>
        <.table_default_cell class="text-sm">
          {Enum.join(Layout.languages(layout), ", ")}
        </.table_default_cell>
        <.table_default_cell>
          <.status_badge status={layout.status} label={status_label(layout.status)} />
          <span :if={layout.uuid == @default_uuid} class="badge badge-sm badge-primary ml-1">
            {gettext("Default")}
          </span>
          <span :if={Layout.system_email?(layout)} class="badge badge-sm badge-outline ml-1">
            {gettext("System email")}
          </span>
        </.table_default_cell>
        <.table_default_cell class="text-right">
          <.table_row_menu id={"layout-menu-#{layout.uuid}"} label={gettext("Actions")}>
            <.table_row_menu_link
              navigate={Paths.layout_edit(layout.uuid)}
              icon="hero-pencil"
              label={gettext("Edit")}
            />
            <.table_row_menu_button
              :if={layout.status == "active" and layout.uuid != @default_uuid}
              phx-click="set_default"
              phx-value-uuid={layout.uuid}
              icon="hero-star"
              label={gettext("Make default")}
            />
            <.table_row_menu_button
              :if={layout.status == "active"}
              phx-click="archive"
              phx-value-uuid={layout.uuid}
              data-confirm={gettext("Archive this layout? Broadcasts already using it keep it.")}
              icon="hero-archive-box"
              label={gettext("Archive")}
            />
            <.table_row_menu_button
              :if={layout.status == "archived" and not Layout.system_email?(layout)}
              phx-click="restore"
              phx-value-uuid={layout.uuid}
              icon="hero-arrow-uturn-left"
              label={gettext("Restore")}
            />
          </.table_row_menu>
        </.table_default_cell>
      </.table_default_row>
    </.table_default_body>
  </.table_default>
</div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
